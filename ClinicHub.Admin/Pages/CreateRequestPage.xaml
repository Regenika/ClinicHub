<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicHub.Admin.Pages.CreateRequestPage"
             Title="Новая заявка">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="?" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
        <Style x:Key="HintLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
        <!-- Чипы-кнопки оформлены так же, как обычные кнопки приложения (CornerRadius 8),
             просто компактнее — чтобы форма смотрелась частью одного приложения, а не отдельным макетом. -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        </Style>
        <Style x:Key="PrimaryChipButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
        </Style>
    </ContentPage.Resources>

    <!-- Desktop-oriented two-column layout: fixed-width form on the left, a wide contextual
         panel (Шаблоны/Контакты) on the right. Wrapped in a horizontal ScrollView so a narrow
         (phone) window scrolls sideways instead of squeezing/stretching the form. -->
    <ScrollView Orientation="Horizontal" VerticalOptions="Fill">
        <Grid Padding="24" RowSpacing="14" WidthRequest="1360" MinimumWidthRequest="1360">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="Новая заявка" FontSize="20" FontAttributes="Bold" />
                <Label Text="Тип (личная/массовая) и режим отправки определяются автоматически — по числу получателей и заполненному времени"
                       FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: form -->
                <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="12">

                    <ScrollView Grid.Row="0">
                        <VerticalStackLayout Spacing="14">

                            <!-- Card 1: Сообщение -->
                            <Border Style="{StaticResource CardStyle}">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="1. Сообщение" Style="{StaticResource CardTitleStyle}" />

                                    <!-- Цель обязательна (Issue #34): от неё зависит проверка согласия на рекламу. -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Цель рассылки" Style="{StaticResource FieldLabelStyle}" />
                                        <Picker x:Name="PurposePicker" Title="Выберите цель"
                                                SelectedIndexChanged="OnPurposeChanged">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>Сервисное — напоминание о записи, перенос, контроль после визита</x:String>
                                                    <x:String>Рекламное — акции, поздравление со скидкой, «давно не были»</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>
                                        <Label Text="Рекламное получат только пациенты с согласием на рекламу по SMS (закон «О рекламе», ст. 18). Остальные будут пропущены, причина видна в заявке."
                                               FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Шаблон" Style="{StaticResource FieldLabelStyle}" />
                                        <Entry x:Name="TemplateSearchEntry"
                                               Placeholder="Найти и выбрать шаблон сообщения…"
                                               TextChanged="OnTemplateSearchChanged"
                                               Focused="OnTemplateFieldFocused" />
                                    </VerticalStackLayout>

                                    <!-- Поля с общим для всей заявки значением (например {doctor}, {cabinet}) -->
                                    <VerticalStackLayout x:Name="PlaceholdersStack" Spacing="6" />

                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <Label Grid.Column="0" Text="Текст сообщения" Style="{StaticResource FieldLabelStyle}" VerticalOptions="Center" />
                                            <Button x:Name="GenderForkButton" Grid.Column="1" Text="Вилка М/Ж ⚥"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Clicked="OnInsertGenderForkClicked" Margin="0,0,6,0" />
                                            <Button x:Name="InsertFieldButton" Grid.Column="2" Text="Вставить поле ▾"
                                                    Style="{StaticResource PrimaryChipButtonStyle}"
                                                    Clicked="OnToggleFieldMenuClicked" />
                                        </Grid>

                                        <FlexLayout x:Name="FieldMenuPanel" IsVisible="False" Wrap="Wrap" JustifyContent="Start"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" Padding="8" />

                                        <Editor x:Name="MessageEditor" HeightRequest="110" AutoSize="TextChanges"
                                                Placeholder="Или введите ваш текст здесь…"
                                                TextChanged="OnMessageTextChanged" />

                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" Padding="12" StrokeDashArray="4,3" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" StrokeShape="RoundRectangle 10">
                                            <VerticalStackLayout Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                    <Label Grid.Column="0" Text="ПРЕВЬЮ" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="для:" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" VerticalOptions="Center" Margin="0,0,6,0" />
                                                    <Button x:Name="PreviewMaleButton" Grid.Column="2" Text="Муж." Style="{StaticResource ChipButtonStyle}"
                                                            Clicked="OnPreviewMaleClicked" Margin="0,0,4,0" />
                                                    <Button x:Name="PreviewFemaleButton" Grid.Column="3" Text="Жен." Style="{StaticResource ChipButtonStyle}"
                                                            Clicked="OnPreviewFemaleClicked" />
                                                </Grid>
                                                <Label x:Name="PreviewLabel" FontSize="13" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card 2: Получатели -->
                            <Border Style="{StaticResource CardStyle}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="2. Получатели" Style="{StaticResource CardTitleStyle}" />
                                    <Button x:Name="RecipientsButton" Text="Ни одного получателя не выбрано — нажмите, чтобы выбрать"
                                            HorizontalOptions="Fill" ContentLayout="Left, 0"
                                            Style="{StaticResource ChipButtonStyle}" FontSize="14" Padding="14,10"
                                            Clicked="OnOpenContactsClicked" />
                                    <FlexLayout x:Name="RecipientsChipsPreview" Wrap="Wrap" JustifyContent="Start" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card 3: Время отправки -->
                            <Border Style="{StaticResource CardStyle}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="3. Время отправки" Style="{StaticResource CardTitleStyle}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="Дата" Style="{StaticResource FieldLabelStyle}" />
                                            <Entry x:Name="ScheduleDateEntry" Placeholder="дд.мм.гггг" TextChanged="OnScheduleChanged" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="Время" Style="{StaticResource FieldLabelStyle}" />
                                            <Entry x:Name="ScheduleTimeEntry" Placeholder="чч:мм" TextChanged="OnScheduleChanged" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Label Text="Не трогайте поля — заявка уйдёт сразу после одобрения. Укажите дату и время — уйдёт позже, в указанный момент."
                                           Style="{StaticResource HintLabelStyle}" />
                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Summary + actions (pinned at bottom of left column) -->
                    <VerticalStackLayout Grid.Row="1" Spacing="10">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}" Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" StrokeShape="RoundRectangle 10" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="ЗАЯВКА В ДВУХ СЛОВАХ" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label x:Name="SummaryLabel" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" LineBreakMode="WordWrap" FontSize="13" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Отмена" Style="{StaticResource ChipButtonStyle}" FontSize="14" Padding="14,10" Clicked="OnCancelClicked" />
                            <Button Grid.Column="1" Text="Создать заявку" FontSize="14" Clicked="OnCreateClicked" />
                        </Grid>
                    </VerticalStackLayout>

                </Grid>

                <!-- RIGHT: contextual panel -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">

                        <HorizontalStackLayout Grid.Row="0" Spacing="4" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" Padding="4">
                            <Button x:Name="TemplatesTabButton" Text="Шаблоны" Style="{StaticResource PrimaryChipButtonStyle}" Clicked="OnShowTemplatesClicked" />
                            <Button x:Name="ContactsTabButton" Text="Контакты" Style="{StaticResource ChipButtonStyle}" BackgroundColor="Transparent" Clicked="OnShowContactsClicked" />
                        </HorizontalStackLayout>

                        <!-- Templates panel -->
                        <Grid x:Name="TemplatesPanel" Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="18">
                            <VerticalStackLayout Grid.Column="0" Spacing="10">
                                <Entry x:Name="TemplateListSearchEntry" Placeholder="найти шаблон…" TextChanged="OnTemplateListSearchChanged" />
                                <CollectionView x:Name="TemplatesCollectionView" SelectionMode="Single" SelectionChanged="OnTemplateSelected">
                                    <CollectionView.EmptyView>
                                        <Label Text="Ничего не найдено — можно написать свой текст в поле слева." TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" Padding="4,12" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="2" Padding="10,8">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" />
                                                <Label Text="{Binding Text}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8" Padding="18,0,0,0">
                                <BoxView HeightRequest="1" WidthRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" HorizontalOptions="Start" />
                                <Label x:Name="TemplatePreviewTitleLabel" Text="Превью шаблона" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label x:Name="TemplatePreviewTextLabel" Text="Наведите на шаблон в списке или выберите его, чтобы увидеть полный текст здесь." FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Contacts panel -->
                        <Grid x:Name="ContactsPanel" Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="12" IsVisible="False">

                            <FlexLayout x:Name="SelectedChipsAllPanel" Grid.Row="0" Wrap="Wrap" JustifyContent="Start" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" Padding="10" />

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="Поиск по имени или телефону" Style="{StaticResource FieldLabelStyle}" />
                                    <Entry x:Name="RecipientsSearchEntry" Placeholder="Например: Смирнов или +7 901" TextChanged="OnRecipientsFilterChanged" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Возраст" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid ColumnDefinitions="64,Auto,64" ColumnSpacing="6">
                                        <Entry x:Name="AgeMinEntry" Grid.Column="0" Placeholder="от" Keyboard="Numeric" WidthRequest="64" TextChanged="OnRecipientsFilterChanged" />
                                        <Label Grid.Column="1" Text="—" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                        <Entry x:Name="AgeMaxEntry" Grid.Column="2" Placeholder="до" Keyboard="Numeric" WidthRequest="64" TextChanged="OnRecipientsFilterChanged" />
                                    </Grid>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="6" MinimumWidthRequest="220">
                                    <Label Text="Из аудитории прошлой заявки" Style="{StaticResource FieldLabelStyle}" />
                                    <Picker x:Name="PreviousAudiencePicker" SelectedIndexChanged="OnRecipientsFilterChanged" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*">
                                    <CheckBox x:Name="SubscribedOnlyCheck" Grid.Column="0" CheckedChanged="OnRecipientsFilterChanged" />
                                    <Label Grid.Column="1" Text="Только подписанные" VerticalOptions="Center" FontSize="12" Margin="0,0,10,0" />
                                    <HorizontalStackLayout Grid.Column="2" Spacing="12" HorizontalOptions="End">
                                        <Button Text="Выбрать всех найденных" FontSize="12" Padding="8,4" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Clicked="OnSelectAllVisibleClicked" />
                                        <Button Text="Очистить всех" FontSize="12" Padding="8,4" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Clicked="OnClearRecipientsClicked" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <CollectionView x:Name="PatientsCollectionView" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="OnPatientsSelectionChanged">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="4" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <Label Text="Никого не найдено по этим фильтрам." TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" Padding="16" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="1" Padding="10,8">
                                                <Label Text="{Binding FullName}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Phone}" />
                                                            <Span Text=" · " />
                                                            <Span Text="{Binding Age}" />
                                                            <Span Text=" лет" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>

                        </Grid>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
