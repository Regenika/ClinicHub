<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:ClinicHub.Admin.Services"
             x:Class="ClinicHub.Admin.Pages.RequestsPage"
             Title="Заявки">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="?" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto" Padding="0">
        <CollectionView x:Name="RequestsView" SelectionMode="Single" SelectionChanged="OnRequestSelected">
            <CollectionView.EmptyView>
                <Label Text="Заявок пока нет" HorizontalOptions="Center" Margin="0,40,0,0" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="16,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label FontSize="12" TextColor="Gray">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Id, StringFormat='#{0} · '}" />
                                        <Span Text="{Binding Type, Converter={x:Static svc:RuTextConverter.Instance}, ConverterParameter=RequestType}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding Purpose, Converter={x:Static svc:RuTextConverter.Instance}, ConverterParameter=Purpose}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="12">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding SentCount, StringFormat='отправлено {0}'}" TextColor="Green" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding FailedCount, StringFormat='ошибок {0}'}" TextColor="Red" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding SkippedCount, StringFormat='пропущено {0}'}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding RecipientCount, StringFormat='всего {0}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#220078D7" StrokeThickness="0"
                                StrokeShape="RoundRectangle 10" VerticalOptions="Start" Padding="8,3">
                            <Label Text="{Binding Status, Converter={x:Static svc:RuTextConverter.Instance}, ConverterParameter=RequestStatus}" FontSize="12" FontAttributes="Bold" TextColor="#0078D7" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Создать заявку" Clicked="OnCreateClicked" Margin="16,8" />
    </Grid>
</ContentPage>