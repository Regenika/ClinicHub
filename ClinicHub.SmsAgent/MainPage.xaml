<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicHub.SmsAgent.MainPage"
             Title="ClinicHub SMS">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="ClinicHub SMS" FontSize="24" FontAttributes="Bold" />
            <Label Text="Этот телефон будет рассылать SMS клиники. Нажмите «Подключиться»: приложение само найдёт компьютер в Wi-Fi и дальше будет работать в фоне — приложение можно закрыть."
                   FontSize="14" />

            <Button x:Name="ConnectBtn" Text="Подключиться" FontSize="20" HeightRequest="64"
                    Clicked="OnConnectClicked" />

            <Label x:Name="StatusLabel" Text="Не подключено." FontSize="16" FontAttributes="Bold" />
            <Label x:Name="HintLabel" FontSize="13" TextColor="Gray" />
            <Label x:Name="LiveLabel" FontSize="12" TextColor="Gray" />
            <Label x:Name="CrashLabel" FontSize="12" IsVisible="False" />

            <Button x:Name="AdvancedBtn" Text="Дополнительно ▾" BackgroundColor="Transparent"
                    TextColor="Gray" Clicked="OnAdvancedClicked" />

            <VerticalStackLayout x:Name="AdvancedPanel" IsVisible="False" Spacing="8">
                <Label Text="Адрес сервера — нужен только если автопоиск не находит компьютер" FontSize="13" />
                <Entry x:Name="UrlEntry" Placeholder="http://192.168.0.2:5112" Keyboard="Url" />
                <Button Text="Подключиться по этому адресу" Clicked="OnConnectManualClicked" />
                <Button Text="Остановить фоновую работу" Clicked="OnStopClicked" />

                <Label Text="Журнал" FontAttributes="Bold" Margin="0,10,0,0" />
                <Editor x:Name="LogEditor" IsReadOnly="True" IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        HeightRequest="300" FontFamily="monospace" FontSize="12" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
