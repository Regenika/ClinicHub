@inherits LayoutComponentBase

@* Макет веб-админки (ADR-0005). Сам макет статический, интерактивны только формы на страницах. *@

<header class="admin-header">
    <div class="container admin-header__row">
        <a class="logo" href="/admin">ClinicHub · админка</a>
        <AuthorizeView>
            <Authorized>
                <nav class="admin-nav" aria-label="Разделы админки">
                    <div class="admin-nav__group" aria-label="Рассылки">
                        <span class="admin-nav__label">SMS</span>
                        <NavLink href="/admin/sms" Match="NavLinkMatch.All">Главная</NavLink>
                        <NavLink href="/admin/sms/napisat">Написать пациенту</NavLink>
                        <NavLink href="/admin/sms/rassylki">Рассылки</NavLink>
                        <NavLink href="/admin/sms/zhurnal">Журнал</NavLink>
                        <NavLink href="/admin/sms/pacienty">Пациенты</NavLink>
                        <NavLink href="/admin/sms/telefony">Телефоны</NavLink>
                        <NavLink href="/admin/sms/shablony">Шаблоны</NavLink>
                    </div>
                    <div class="admin-nav__group" aria-label="Сайт">
                        <span class="admin-nav__label">Сайт</span>
                        <NavLink href="/admin/uslugi">Услуги и цены</NavLink>
                        <NavLink href="/admin/vrachi">Специалисты</NavLink>
                        <NavLink href="/admin/nastroiki">Настройки сайта</NavLink>
                        <NavLink href="/admin/stranicy">Страницы</NavLink>
                        <NavLink href="/admin/media">Медиатека</NavLink>
                        <NavLink href="/admin/redaktory">Сотрудники</NavLink>
                    </div>
                </nav>
                <div class="admin-header__user">
                    <a href="/" target="_blank" rel="noopener">Открыть сайт</a>
                    <span class="muted">@context.User.FindFirst("display_name")?.Value</span>
                    <form method="post" action="@AdminAuth.LogoutPath">
                        <AntiforgeryToken />
                        <button class="btn btn--outline btn--sm" type="submit">Выйти</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

<main id="main" class="container admin-main">
    @Body
</main>
