@inherits LayoutComponentBase

@* Макет веб-админки (ADR-0005). Сам макет статический, интерактивны только формы на страницах. *@

<header class="admin-header">
    <div class="container admin-header__row">
        <a class="logo" href="/admin">ClinicHub · админка</a>
        <AuthorizeView>
            <Authorized>
                <nav class="admin-nav" aria-label="Разделы админки">
                    <a href="/admin/uslugi">Услуги и цены</a>
                    <a href="/admin/vrachi">Врачи</a>
                    <a href="/admin/nastroiki">Настройки сайта</a>
                    <a href="/admin/stranicy">Страницы</a>
                    <a href="/admin/media">Медиатека</a>
                    <a href="/admin/redaktory">Редакторы</a>
                </nav>
                <div class="admin-header__user">
                    <a href="/" target="_blank" rel="noopener">Открыть сайт</a>
                    <span class="muted">@context.User.FindFirst("display_name")?.Value</span>
                    <form method="post" action="@AdminAuth.LogoutPath">
                        <AntiforgeryToken />
                        <button class="btn btn--outline btn--sm" type="submit">Выйти</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

<main id="main" class="container admin-main">
    @Body
</main>
