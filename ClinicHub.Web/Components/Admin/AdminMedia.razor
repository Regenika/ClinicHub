@page "/admin/media"
@attribute [Authorize]
@rendermode InteractiveServer
@layout AdminLayout
@inject MediaLibrary Media

<PageTitle>Медиатека — админка</PageTitle>

<section class="stack-lg">
    <h1 class="h2">Медиатека</h1>
    <p class="muted">
        Картинки для блоков страниц и фото врачей. JPEG, PNG, WebP или GIF до @(MediaLibrary.MaxBytes / 1024 / 1024) МБ;
        для сайта хватает 2000 пикселей по длинной стороне. Картинки хранятся в общей базе — видны на всех компьютерах сразу.
        Фото пациентов («до и после») — только с письменного согласия.
    </p>

    <div class="setup__form stack admin-form">
        <label class="field">
            <span>Загрузить картинки (можно несколько)</span>
            <InputFile OnChange="UploadAsync" multiple accept="image/jpeg,image/png,image/webp,image/gif" disabled="@busy" />
        </label>
        @if (busy)
        {
            <p class="muted">Загружаю…</p>
        }
        @foreach (var m in messages)
        {
            <p class="@(m.Error ? "form-errors" : "notice")">@m.Text</p>
        }
    </div>

    @if (framing is not null)
    {
        <FramingEditor Media="framing" OnSave="SaveFramingAsync" OnClose="() => framing = null" />
    }

    @if (items.Count == 0)
    {
        <p class="muted">Картинок пока нет.</p>
    }
    <div class="media-grid">
        @foreach (var m in items)
        {
            <figure class="card media-card">
                <a href="@m.Url" target="_blank" rel="noopener"><img src="@m.Url" alt="@m.Alt" loading="lazy" /></a>
                <figcaption class="stack-sm">
                    <span class="small">@m.FileName <span class="muted">· @(m.Size / 1024) КБ</span></span>
                    <label class="field">
                        <span class="muted small">Описание (alt)</span>
                        <input type="text" value="@m.Alt" placeholder="Что на картинке" @onchange="e => SaveAltAsync(m.Id, e.Value as string)" />
                    </label>
                    <button class="btn btn--outline btn--sm" @onclick="() => framing = m">Кадр: что оставить в рамке</button>
                    @if (confirmDelete == m.Id)
                    {
                        <button class="btn btn--danger btn--sm" @onclick="() => DeleteAsync(m.Id)">Точно удалить? Там, где она стоит, будет пусто</button>
                    }
                    else
                    {
                        <button class="btn btn--outline btn--sm" @onclick="() => confirmDelete = m.Id">Удалить</button>
                    }
                </figcaption>
            </figure>
        }
    </div>
</section>

@code {
    private sealed record Message(string Text, bool Error);

    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private IReadOnlyList<MediaInfo> items = [];
    private readonly List<Message> messages = [];
    private int? confirmDelete;
    private bool busy;

    protected override async Task OnInitializedAsync() => items = await Media.ListAsync();

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        busy = true;
        messages.Clear();
        var editor = AdminAuth.LoginOf((await Auth).User);
        foreach (var file in e.GetMultipleFiles(20))
        {
            if (file.Size > MediaLibrary.MaxBytes)
            {
                messages.Add(new($"«{file.Name}»: больше {MediaLibrary.MaxBytes / 1024 / 1024} МБ, не загружен.", true));
                continue;
            }
            using var ms = new MemoryStream();
            await file.OpenReadStream(MediaLibrary.MaxBytes).CopyToAsync(ms);
            var (info, error) = await Media.UploadAsync(file.Name, ms.ToArray(), editor);
            messages.Add(info is not null && error is null
                ? new($"«{file.Name}» загружен. Добавьте описание ниже.", false)
                : new($"«{file.Name}»: {error}", info is null));
        }
        items = await Media.ListAsync();
        busy = false;
    }

    private async Task SaveAltAsync(int id, string? alt)
    {
        await Media.SetAltAsync(id, alt ?? "");
        items = await Media.ListAsync();
    }

    private MediaInfo? framing;

    private async Task SaveFramingAsync((int X, int Y, int Zoom) f)
    {
        await Media.SetFramingAsync(framing!.Id, f.X, f.Y, f.Zoom);
        items = await Media.ListAsync();
        messages.Clear();
        messages.Add(new($"Кадр «{framing.FileName}» сохранён. На этом компьютере уже видно, на других — в течение 30 секунд.", false));
        framing = null;
    }

    private async Task DeleteAsync(int id)
    {
        await Media.DeleteAsync(id);
        confirmDelete = null;
        items = await Media.ListAsync();
    }
}
