@* Блок «Специалисты»: специалисты из каталога, блок хранит только выбор. *@
@inject ISiteCatalog Catalog

<section id="@Settings.Anchor" class="container section stack-lg" aria-labelledby="@TitleId">
    <h2 id="@TitleId" class="h2">@Settings.Title</h2>
    <div class="cards">
        @foreach (var d in Catalog.Doctors.Pick(Settings.DoctorIds, x => x.Id))
        {
            <article class="doctor">
                @if (photos.Contains(d.Id))
                {
                    <div class="photo-frame photo-slot--doctor"><MediaImg Id="d.PhotoId" CssClass="cover" /></div>
                }
                else
                {
                    <div class="photo-slot photo-slot--doctor" role="img" aria-label="Место для фотографии специалиста">[ФОТО СПЕЦИАЛИСТА]</div>
                }
                <h3 class="h3">@d.Name</h3>
                <p class="muted">@d.Role</p>
                <a href="/zapis?doctor=@d.Id">Записаться к специалисту</a>
            </article>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public DoctorsBlock Settings { get; set; } = default!;
    [Parameter, EditorRequired] public ClinicInfo Clinic { get; set; } = default!;

    private string TitleId => Settings.Anchor + "-title";

    [Inject] private MediaLibrary Media { get; set; } = default!;
    /// <summary>Специалисты, у которых фото есть в медиатеке.</summary>
    private HashSet<string> photos = [];

    protected override async Task OnParametersSetAsync()
    {
        var media = await Media.ListAsync();
        photos = Catalog.Doctors.Where(d => d.PhotoId is { } id && media.Any(m => m.Id == id)).Select(d => d.Id).ToHashSet();
    }
}
