@* Блок «Каналы»: ссылки на Telegram, MAX и ВКонтакте из настроек сайта. *@

<section class="channels" aria-labelledby="channels-title">
    <div class="container channels__row">
        <div class="stack-sm channels__text">
            <h2 id="channels-title" class="h2 h2--sm">@Settings.Title</h2>
            <p>@Settings.Text</p>
        </div>
        <div class="row-wrap">
            <a class="btn btn--light" href="@Clinic.TelegramUrl" rel="noopener">Telegram</a>
            <a class="btn btn--light" href="@Clinic.MaxUrl" rel="noopener">MAX</a>
            <a class="btn btn--light" href="@Clinic.VkUrl" rel="noopener">ВКонтакте</a>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ChannelsBlock Settings { get; set; } = default!;
    [Parameter, EditorRequired] public ClinicInfo Clinic { get; set; } = default!;
}
