@* Блок «До и после». *@

<section id="@Settings.Anchor" class="band" aria-labelledby="@TitleId">
    <div class="container split">
        <div class="split__aside stack">
            <h2 id="@TitleId" class="h2">@Settings.Title</h2>
            <p class="muted-strong">@Settings.Intro</p>
        </div>
        <div class="split__main cards">
            @foreach (var r in Settings.Items)
            {
                <figure class="result">
                    @if (r.ImageId is { } imageId && media.Any(m => m.Id == imageId))
                    {
                        <div class="photo-frame photo-slot--result"><MediaImg Id="imageId" CssClass="cover" /></div>
                    }
                    else
                    {
                        <div class="photo-slot photo-slot--result" role="img" aria-label="Место для пары фото до и после">@r.ConsentNote</div>
                    }
                    <figcaption class="muted small">@r.Caption</figcaption>
                </figure>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ResultsBlock Settings { get; set; } = default!;
    [Parameter, EditorRequired] public ClinicInfo Clinic { get; set; } = default!;

    private string TitleId => Settings.Anchor + "-title";

    [Inject] private MediaLibrary Media { get; set; } = default!;
    private IReadOnlyList<MediaInfo> media = [];

    protected override async Task OnParametersSetAsync() => media = await Media.ListAsync();
}
