@* Заголовок, описание, canonical и Open Graph для страницы. *@
@inject SiteStore Store

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    @if (NoIndex)
    {
        <meta name="robots" content="noindex" />
    }
    else if (CanonicalUrl is { } canonical)
    {
        <link rel="canonical" href="@canonical" />
        <meta property="og:url" content="@canonical" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="@clinic.Name" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    @ChildContent
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    /// <summary>Путь страницы от корня, например "/zapis".</summary>
    [Parameter] public string Path { get; set; } = "/";
    [Parameter] public bool NoIndex { get; set; }
    /// <summary>Дополнительные теги в head (например, микроразметка).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private ClinicInfo clinic = new();

    protected override async Task OnInitializedAsync() => clinic = await Store.GetClinicAsync();

    private string? CanonicalUrl =>
        SiteUrls.BaseUrl(clinic, HttpContext?.Request) is { } b ? b + Path : null;
}
