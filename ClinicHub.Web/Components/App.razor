<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tenor+Sans&family=Golos+Text:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <HeadOutlet />
</head>

<body>
    @* Публичный сайт работает без JavaScript: формы и переходы — обычные запросы.
       blazor.web.js (канал интерактивных компонентов) грузится только в админке. *@
    <Routes />
    @if (IsAdmin)
    {
        <script src="_framework/blazor.web.js"></script>
    }
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool IsAdmin => HttpContext?.Request.Path.StartsWithSegments("/admin") == true;
}
